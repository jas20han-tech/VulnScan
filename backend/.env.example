# VulnScan backend configuration
# SQLite for v1 local dev. Swap to postgres in production.
DATABASE_URL=sqlite+aiosqlite:///./vulnscan.db

# Fix generation provider: auto | ollama | anthropic | template
FIX_GENERATOR_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Crawler politeness / rate limiting
SCAN_DEFAULT_DELAY_MS=250
SCAN_MAX_CONCURRENT_REQUESTS=5
CRAWL_MAX_DEPTH=5
CRAWL_MAX_PAGES=200
RESPECT_ROBOTS_TXT=false

# Consent confirmation phrase
CONSENT_CONFIRMATION_PHRASE_TEMPLATE=I own or am authorized to test {domain}

# Auth/session checks
AUTH_LOGIN_ATTEMPT_COUNT=10

# XSS module
XSS_MAX_PLAYWRIGHT_ATTEMPTS=20

# Reporting
REPORT_OUTPUT_DIR=./reports

# API base URL for building report/asset links
APP_BASE_URL=http://localhost:8000
